{
  "name": "evidex",
  "version": "1.0.0",
  "description": "AI-powered research evidence extraction tool",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.api.json",
    "test": "npm run build && node --no-experimental-require-module --test dist/__tests__/*.test.js",
    "test:highlight": "node scripts/highlighting-regression.mjs",
    "test:api": "node tests/smoke-api.mjs",
    "dev": "node dist/server.js",
    "start": "npm run build && npm run dev"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/pdfkit": "^0.17.3",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^26.1.0",
    "node-fetch": "^2.7.0",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.13",
    "@vercel/node": "^3.0.0",
    "typescript": "^5.5.3"
  },
  "private": true
}
